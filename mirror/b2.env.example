# Copy to mirror/b2.env (gitignored) and fill in.
#
# Use a READ-ONLY B2 application key restricted to the archive bucket AND to
# the file-name prefix "archive/" (Application Keys -> Add -> Type of Access:
# Read Only -> File name prefix: archive/ -> tick "Allow List All Bucket
# Names"). With that prefix the key cannot even list the index/ folder,
# where the (encrypted) secrets bundle lives. A mirror must never hold a key
# that can write or delete.
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=REPLACE_ME_readonly_keyID
RCLONE_CONFIG_B2_KEY=REPLACE_ME_readonly_applicationKey
B2_BUCKET=REPLACE_ME_bucket_name

# How often to pull new snapshots (seconds). Hourly is plenty: the primary
# only pushes to B2 nightly.
SYNC_INTERVAL_SECONDS=3600

# Shown on the front page.
SITE_NAME=MemoriesLane Archive — mirror
# "Label=URL,Label=URL" -- the other places the archive lives. The onion
# address is added automatically once tor has generated it.
MIRROR_LINKS=Primary=https://archivebox.heomay.xyz

# Only for `docker compose --profile tls`: the hostname Caddy should serve.
MIRROR_DOMAIN=mirror.example.org

# Optional rclone filter to mirror a subset, e.g. for a smoke test:
#   SYNC_INCLUDE=/1789696670.980997/**
# Leave unset for the full archive.
