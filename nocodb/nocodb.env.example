# Copy to nocodb/nocodb.env (gitignored) on the VPS. Read only by the
# `nocodb` service in docker-compose.vps.yml.

# Long random secret that signs NocoDB's login sessions. Rotating it logs
# everyone out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NC_AUTH_JWT_SECRET=replace_me_with_64_hex_chars

# Bootstrap super-admin (created on first boot only; change the password in
# the UI afterwards). This is the maintainer's account, not the content
# manager's -- the content manager gets invited from inside NocoDB with the
# Editor role and never sees the data-source credentials.
NC_ADMIN_EMAIL=you@example.com
NC_ADMIN_PASSWORD=replace_me_8plus_chars_with_Upper_digit_and_symbol

# Public origin, so invite / password-reset links point at the tunnel
# hostname rather than localhost:8080.
NC_SITE_URL=https://memorylanedb.heomay.xyz
