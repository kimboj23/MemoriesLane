# Copy to capture/.env (gitignored). Everything is optional for local dev.

# Storage: local (default, a docker volume) or s3 (Backblaze B2 / any S3-compatible)
# STORAGE_BACKEND=s3
# S3_BUCKET=memlane-capture
# S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# S3_REGION=eu-central-003
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PREFIX=capture/

# Internet Archive SPN2 keys (https://archive.org/account/s3.php). Without them, Wayback copies are "skipped".
# Copies are made for projects with "Share with the Internet Archive" on, or on request. Submissions are PUBLIC.
# IA_ACCESS_KEY=
# IA_SECRET_KEY=
# WAYBACK_DEFAULT_UNFILED=false     # also send links that aren't filed under any incident

# Map tiles. Each tile request tells the tile server which area is being looked at: use a self-hosted or trusted
# server for sensitive work. The page's Content-Security-Policy allows this origin only.
# TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# TILE_ATTRIBUTION=© OpenStreetMap contributors

# Signed artifact URLs: set when running more than one API process
# ARTIFACT_URL_SECRET=

# Optional egress proxy for all capture traffic (e.g. residential / VN region), proposal §6.4
# CAPTURE_PROXY=http://user:pass@host:port

# Optional yt-dlp cookies per platform, THROWAWAY ACCOUNTS ONLY (archivebox/THROWAWAY-ACCOUNTS.md).
# Mount the file into the worker and point at it:
# COOKIES_FACEBOOK=/secrets/facebook.cookies.txt
# COOKIES_YOUTUBE=/secrets/youtube.cookies.txt

# API
# CORS_ORIGINS=https://memorylane101.pages.dev
# SUBMIT_RATE_PER_HOUR=120

# Worker
# WORKER_CONCURRENCY=2
# LOG_LEVEL=INFO
