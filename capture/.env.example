# Copy to capture/.env (gitignored). Everything is optional for local dev.

# Storage: local (default, a docker volume) or s3 (Backblaze B2 / any S3-compatible)
# STORAGE_BACKEND=s3
# S3_BUCKET=memlane-capture
# S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# S3_REGION=eu-central-003
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PREFIX=capture/

# Internet Archive SPN2 keys (https://archive.org/account/s3.php). Without them, Wayback copies are "skipped".
# Copies are made for projects with "Share with the Internet Archive" on, or on request. Submissions are PUBLIC.
# IA_ACCESS_KEY=
# IA_SECRET_KEY=
# WAYBACK_DEFAULT_UNFILED=false     # also send links that aren't filed under any incident

# Map tiles. Each tile request tells the tile server which area is being looked at: use a self-hosted or trusted
# server for sensitive work. The page's Content-Security-Policy allows this origin only.
# Default is CARTO Voyager (like the public map). OpenStreetMap's own tile servers block apps (HTTP 403).
# TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?key=<CARTO basemaps key>
# TILE_SUBDOMAINS=abcd
# TILE_ATTRIBUTION=© OpenStreetMap contributors · © CARTO

# Community intake (docs/integration-design.md §5). Random hex; every source's key is derived from it, so rotating
# it changes every source's key. Without it the Intake API answers 503.
# INTAKE_KEY_SECRET=
# Opens contact details the sites sealed to the hub (python -m memlane_capture.admin contact-key-init)
# CONTACT_SECRET_KEY=
# INTAKE_MAX_VIDEO_MB=60
# INTAKE_MAX_FILE_MB=20

# Publication feed (§6.2, §13). Production: a separate public B2 bucket behind Cloudflare (decision 5).
# FEED_STORE=s3
# FEED_S3_BUCKET=memlane-feed
# FEED_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# FEED_S3_REGION=eu-central-003
# FEED_S3_ACCESS_KEY=
# FEED_S3_SECRET_KEY=
# FEED_PUBLIC_URL=https://<feed host>
# Signing (memlane_capture/feedkeys.py): the online key and the offline root's delegation for it, as files in
# capture/secrets/ (mounted at /secrets). The root key itself never comes to the server.
# FEED_ONLINE_KEY=/secrets/feed-online.key
# FEED_DELEGATION=/secrets/feed-delegation.json
# FEED_REVOCATIONS=/secrets/feed-revocations.jsonl
# FEED_SERVE_LOCAL=true            # development only: serve the feed at /feed/
# FEED_WEBHOOKS=https://<site backend>/api/hub-feed-changed

# Signed artifact URLs: set when running more than one API process
# ARTIFACT_URL_SECRET=

# Residential egress (egress.py; proposal §6.4). Meta rate-limits datacenter addresses (Threads: HTTP 429,
# Instagram: a login redirect with is_from_rle). One IP per capture: {port} becomes a random port in
# CAPTURE_PROXY_PORTS (DataImpulse sticky ports; dashboard: country Vietnam, sticky, interval about 5 min).
# Only CAPTURE_PROXY_PLATFORMS use it; in the browser Meta's file servers go direct (CAPTURE_PROXY_BYPASS),
# which cut billed traffic about 10× (0.2-0.6 MB per Threads save, measured 2026-10-21). Credentials: never commit.
# CAPTURE_PROXY=http://LOGIN__cr.vn:PASSWORD@gw.dataimpulse.com:{port}
# CAPTURE_PROXY_PORTS=10000-20000
# CAPTURE_PROXY_PLATFORMS=threads,instagram
# CAPTURE_PROXY_BYPASS=.cdninstagram.com,.fbcdn.net
# Chromium with a virtual display (Xvfb, started by the worker) instead of headless: fewer automation tells.
# CAPTURE_HEADFUL=1

# Optional yt-dlp cookies per platform, THROWAWAY ACCOUNTS ONLY (archivebox/THROWAWAY-ACCOUNTS.md).
# Mount the file into the worker and point at it:
# COOKIES_FACEBOOK=/secrets/facebook.cookies.txt
# COOKIES_YOUTUBE=/secrets/youtube.cookies.txt

# API
# CORS_ORIGINS=https://memorylane101.pages.dev
# SUBMIT_RATE_PER_HOUR=120

# Worker
# WORKER_CONCURRENCY=2
# LOG_LEVEL=INFO
