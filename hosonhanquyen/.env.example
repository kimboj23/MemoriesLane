# Copy to .env (gitignored). `npm run seed-demo -- setup` writes one for local use.
PORT=3903
BIND_ADDR=127.0.0.1
# behind a TLS proxy: trust one hop for the client address (used only for the hourly rate-limit HMAC)
# TRUST_PROXY=true
# RATE_HMAC_SECRET=<random hex>

# The hub (capture/): Intake API + this site's source key (shown once in the hub's Admin page; server-side only)
HUB_URL=https://<hub intake host>
HUB_SOURCE=ho-so-nhan-quyen
HUB_INTAKE_KEY=

# The published feed, and the hub's ROOT public key (pinned; never taken from the feed itself)
HUB_FEED_URL=https://<feed host>
HUB_FEED_ROOT_KEY=
FEED_REFRESH_S=60
# which hub collections (project codes) this site shows
FEED_COLLECTIONS=HSNQ

# Map tiles (the page's CSP allows this origin); a CARTO key, if any, goes in the URL
# TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?key=...
